{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": " 󰁔 ",
        "color": {
            "separator": "cyan"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}  {host-name}",
            "color": {
                "user": "magenta",
                "at": "white",
                "host": "cyan"
            }
        },
        {
            "type": "separator",
            "string": "──────────────────────────────────",
            "outputColor": "blue"
        },
        {
            "type": "os",
            "key": " os    ",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": " kernel",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": "󰅐 uptime",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "󰏖 pkgs  ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "key": " shell ",
            "keyColor": "blue",
            "format": "zsh"
        },
        {
            "type": "terminal",
            "key": " term  ",
            "keyColor": "red"
        },
        {
            "type": "cpu",
            "key": "󰍛 cpu   ",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": " memory",
            "keyColor": "yellow"
        },
        {
            "type": "battery",
            "key": "󰂄 power ",
            "keyColor": "green"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
